---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import '../styles/pages.css';
---
<Base title="Page not found | GHC Outer Ring Road" sub>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Page not found</span>
      <h1>We couldn't find that page.</h1>
      <p>It may have moved, or the link may be mistyped. These will help you find your way.</p>
      <div class="meta">
        <a class="btn btn-y" href="/">Go to the homepage</a>
        <a class="btn btn-o" href="/sermons/">Sermons</a>
        <a class="btn btn-o" href="/events/">Events</a>
      </div>
    </div>
  </section>
  <Footer />
</Base>
